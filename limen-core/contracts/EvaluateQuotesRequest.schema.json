{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluateQuotesRequest",
  "$ref": "#/$defs/EvaluateQuotesRequest",
  "$defs": {
    "EvaluateQuotesRequest": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "requirement": {
          "$ref": "#/$defs/Requirement"
        },
        "buyer_profile": {
          "$ref": "#/$defs/BuyerProfile"
        },
        "buyer_policy": {
          "$ref": "#/$defs/BuyerPolicy"
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          }
        },
        "listings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SupplierListing"
          }
        },
        "histories": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DeliveryHistory"
          }
        },
        "max_suppliers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "actor",
        "requirement",
        "buyer_profile",
        "buyer_policy",
        "quotes"
      ],
      "additionalProperties": false
    },
    "Actor": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "BUYER_SALES",
            "BUYER_HEAD",
            "BUYER_FINANCE",
            "SUPPLIER_OWNER",
            "SUPPLIER_STAFF",
            "PLATFORM"
          ]
        },
        "org_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "org_id",
        "user_id"
      ],
      "additionalProperties": false
    },
    "Requirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "buyer_org_id": {
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "specs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SpecConstraint"
          }
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 1
        },
        "uom": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery_city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "need_by_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "required_certifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preferred_credit_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Sourced"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        }
      },
      "required": [
        "requirement_id",
        "buyer_org_id"
      ],
      "additionalProperties": false
    },
    "SpecConstraint": {
      "type": "object",
      "properties": {
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "one_of": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "USER_STATED",
            "DOCUMENT_EXTRACTED",
            "SUPPLIER_DECLARED",
            "VERIFIED",
            "LIMEN_TRANSACTION",
            "ESTIMATED",
            "DEFAULT_ASSUMPTION"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Sourced": {
      "type": "object",
      "properties": {
        "value": {},
        "source": {
          "type": "string",
          "enum": [
            "USER_STATED",
            "DOCUMENT_EXTRACTED",
            "SUPPLIER_DECLARED",
            "VERIFIED",
            "LIMEN_TRANSACTION",
            "ESTIMATED",
            "DEFAULT_ASSUMPTION"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "source"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "BLOCKING",
            "WARNING"
          ]
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "field",
        "message"
      ],
      "additionalProperties": false
    },
    "BuyerProfile": {
      "type": "object",
      "properties": {
        "buyer_org_id": {
          "type": "string"
        },
        "plant_city": {
          "type": "string"
        },
        "cost_of_capital_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "itc_eligible_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "itc_lag_days": {
          "type": "integer",
          "minimum": 0
        },
        "freight_rate_paise_per_tonne_km": {
          "type": "integer",
          "minimum": 0
        },
        "late_cost_per_day_paise": {
          "type": "integer",
          "minimum": 0
        },
        "min_ontime_fraction_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "rejection_cost_bps": {
          "type": "integer",
          "minimum": 0
        },
        "extra_supplier_admin_cost_paise": {
          "type": "integer",
          "minimum": 0
        },
        "assumed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "buyer_org_id",
        "plant_city"
      ],
      "additionalProperties": false
    },
    "BuyerPolicy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "buyer_org_id": {
          "type": "string"
        },
        "max_per_deal_units": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]{0,38})"
        },
        "max_total_units": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]{0,38})"
        },
        "expires_at_unix": {
          "type": "integer",
          "minimum": 0
        },
        "spent_units": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]{0,38})"
        },
        "pending_units": {
          "type": "string",
          "pattern": "(0|[1-9][0-9]{0,38})"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policy_id",
        "buyer_org_id",
        "max_per_deal_units",
        "max_total_units",
        "expires_at_unix"
      ],
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "BUYER_SALES",
            "BUYER_HEAD",
            "BUYER_FINANCE",
            "SUPPLIER_OWNER",
            "SUPPLIER_STAFF",
            "PLATFORM"
          ]
        },
        "user_id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "user_id",
        "at"
      ],
      "additionalProperties": false
    },
    "Quote": {
      "type": "object",
      "properties": {
        "quote_id": {
          "type": "string"
        },
        "rfq_id": {
          "type": "string"
        },
        "supplier_id": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "terms": {
          "$ref": "#/$defs/OfferTerms"
        },
        "moq": {
          "type": "integer",
          "minimum": 1
        },
        "max_quantity": {
          "type": "integer",
          "minimum": 1
        },
        "validity_days": {
          "type": "integer",
          "minimum": 1
        },
        "spec_declared": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SpecOffered"
          }
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "quote_id",
        "rfq_id",
        "supplier_id",
        "product_id",
        "terms"
      ],
      "additionalProperties": false
    },
    "OfferTerms": {
      "type": "object",
      "properties": {
        "unit_price_paise": {
          "type": "integer",
          "minimum": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "credit_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "delivery_basis": {
          "type": "string",
          "enum": [
            "FOR_DESTINATION",
            "EX_WORKS"
          ]
        },
        "freight_per_unit_paise": {
          "type": "integer",
          "minimum": 0
        },
        "gst_rate_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "gst_registration": {
          "type": "string",
          "enum": [
            "REGULAR",
            "COMPOSITION",
            "UNREGISTERED"
          ]
        },
        "lead_time_days": {
          "type": "integer",
          "minimum": 0
        },
        "advance_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "unit_price_paise",
        "quantity"
      ],
      "additionalProperties": false
    },
    "SpecOffered": {
      "type": "object",
      "properties": {
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "USER_STATED",
            "DOCUMENT_EXTRACTED",
            "SUPPLIER_DECLARED",
            "VERIFIED",
            "LIMEN_TRANSACTION",
            "ESTIMATED",
            "DEFAULT_ASSUMPTION"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SupplierListing": {
      "type": "object",
      "properties": {
        "supplier_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "gst_registration": {
          "type": "string",
          "enum": [
            "REGULAR",
            "COMPOSITION",
            "UNREGISTERED"
          ]
        },
        "is_msme": {
          "type": "boolean"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Product"
          }
        },
        "certifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Certification"
          }
        }
      },
      "required": [
        "supplier_id",
        "name",
        "city"
      ],
      "additionalProperties": false
    },
    "Product": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "specs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SpecOffered"
          }
        },
        "uom": {
          "type": "string"
        },
        "unit_weight_kg": {
          "type": "number",
          "minimum": 0
        },
        "moq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 1
        },
        "monthly_capacity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "standard_lead_time_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "gst_rate_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        }
      },
      "required": [
        "product_id",
        "category",
        "material"
      ],
      "additionalProperties": false
    },
    "Certification": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "DeliveryHistory": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "integer",
          "minimum": 0
        },
        "on_time": {
          "type": "integer",
          "minimum": 0
        },
        "late_days_total": {
          "type": "integer",
          "minimum": 0
        },
        "lots_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "lots_rejected": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
