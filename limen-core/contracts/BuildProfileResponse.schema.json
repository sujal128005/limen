{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BuildProfileResponse",
  "$ref": "#/$defs/BuildProfileResponse",
  "$defs": {
    "BuildProfileResponse": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string"
        },
        "listing": {
          "$ref": "#/$defs/SupplierListing"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Sourced"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        }
      },
      "required": [
        "audience",
        "listing",
        "provenance",
        "issues"
      ],
      "additionalProperties": false
    },
    "SupplierListing": {
      "type": "object",
      "properties": {
        "supplier_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "gst_registration": {
          "type": "string",
          "enum": [
            "REGULAR",
            "COMPOSITION",
            "UNREGISTERED"
          ]
        },
        "is_msme": {
          "type": "boolean"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Product"
          }
        },
        "certifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Certification"
          }
        }
      },
      "required": [
        "supplier_id",
        "name",
        "city"
      ],
      "additionalProperties": false
    },
    "Product": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "specs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SpecOffered"
          }
        },
        "uom": {
          "type": "string"
        },
        "unit_weight_kg": {
          "type": "number",
          "minimum": 0
        },
        "moq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 1
        },
        "monthly_capacity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "standard_lead_time_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "gst_rate_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        }
      },
      "required": [
        "product_id",
        "category",
        "material"
      ],
      "additionalProperties": false
    },
    "SpecOffered": {
      "type": "object",
      "properties": {
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "USER_STATED",
            "DOCUMENT_EXTRACTED",
            "SUPPLIER_DECLARED",
            "VERIFIED",
            "LIMEN_TRANSACTION",
            "ESTIMATED",
            "DEFAULT_ASSUMPTION"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Certification": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "Sourced": {
      "type": "object",
      "properties": {
        "value": {},
        "source": {
          "type": "string",
          "enum": [
            "USER_STATED",
            "DOCUMENT_EXTRACTED",
            "SUPPLIER_DECLARED",
            "VERIFIED",
            "LIMEN_TRANSACTION",
            "ESTIMATED",
            "DEFAULT_ASSUMPTION"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "source"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "BLOCKING",
            "WARNING"
          ]
        },
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "field",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
