# Limen runs fully without any of these. Every variable below is optional.
# Copy to .env only if you want to change the defaults.

# ---------------------------------------------------------------- LLM layer
# Optional. Enables the model that rephrases Rationale's answers. Without it,
# Rationale runs on the local deterministic responder and the product behaves
# identically. Server side only: never expose this to the browser.
#
# Any OpenAI-compatible chat completions API works. Set LLM_BASE_URL to switch
# provider without touching code. Leave it unset for xAI.
#
#   xAI        https://api.x.ai/v1            grok-3-mini
#   Groq       https://api.groq.com/openai/v1 openai/gpt-oss-20b
#   OpenAI     https://api.openai.com/v1      gpt-4o-mini
#   OpenRouter https://openrouter.ai/api/v1   (many, some free)
#
# Model names move. Run `node scripts/llm-check.js --models` to list what the
# configured provider will actually serve before setting LLM_MODEL.

# This file is a committed template. It must never contain a real value.
# Put real keys in .env, which is gitignored.

LLM_API_KEY=gsk_paste_real_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Legacy names, still honoured so existing setups keep working.
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Optional. Port for the application server.
PORT=4000

# Optional. Point at any EVM JSON-RPC endpoint (for example Base Sepolia) to run
# against a public network instead of the in-process chain. Requires DEPLOYER_KEY.
RPC_URL=
DEPLOYER_KEY=

# Optional. Gives the agent its own key when running against a public network.
# On the local chain the agent already has a separate account.
AGENT_KEY=

# ------------------------------------------------------------ payment rail
# Optional. Without these, payouts run on a local rail that behaves the same
# way: it holds the payout in `processing` and then delivers a real webhook
# event to the same handler Razorpay posts to. Nothing is stubbed to success.
#
# With them set, the same code path calls Razorpay Payouts in test mode. The
# idempotency key is derived from the purchase and its approval, so a retry
# after a timeout returns the original payout rather than paying twice.
#
# Server side only. None of these may ever be exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# Which bank account each supplier is paid into, as JSON: {"SUP-1":"fa_xxx"}.
# A fund account is a real record against verified bank details, so there is
# nothing honest to put here by default. A payout for a supplier with no entry
# is refused before it reaches the rail rather than failing confusingly there.
RAZORPAY_FUND_ACCOUNTS={}

# Bounded retry on the create call. A timeout says nothing about whether the
# payout was made, and the derived idempotency key is what makes trying again
# safe rather than a way to pay a supplier twice.
RAZORPAY_MAX_ATTEMPTS=3
RAZORPAY_TIMEOUT_MS=15000

# Webhook signatures are verified over the raw request bytes. Set this to the
# secret configured on the Razorpay webhook; the default below only matches the
# local rail and is not a secret in any meaningful sense.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------ session
# Role tokens are signed with this. Left unset, a random secret is minted at
# boot, which means a restart signs everyone out. Set it to keep sessions
# across restarts. It is not a password: there are no accounts to hold one.
LIMEN_SESSION_SECRET=

# ---------------------------------------------------------------- demo dials
# How many purchases the spending policy authorises in total, as a multiple of
# the per-deal ceiling. The per-deal ceiling itself is always the stated budget
# and is not configurable, because it is the limit the whole demonstration
# turns on.
LIMEN_TOTAL_CAP_MULTIPLE=3

# How long the local rail waits before reporting a payout as processed. Only
# used when no Razorpay credentials are set.
LIMEN_LOCAL_SETTLE_MS=2500

# Requests per minute per address before the server starts refusing. Raised
# only by the HTTP test suite, which drives dozens of workflows from one host.
LIMEN_RATE_LIMIT=240

# ------------------------------------------------------------------ storage
# Where workspaces, approvals, payments and the audit trail live. Unset, the
# server runs on an in-memory adapter and says so at boot: everything is lost
# when the process stops. Any Postgres works.
DATABASE_URL=

# Certificate verification for that connection. Hosted Postgres usually presents
# a chain a client cannot verify against a public root, so this defaults to off
# and is opt-in rather than silently strict.
DATABASE_SSL_STRICT=false
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------ identity
# Derives one on-chain buyer wallet per workspace, so two customers never share
# a spending envelope. On a public network this MUST be set: the development
# phrase used locally is published in every tutorial, and the server refuses to
# start with it rather than deriving keys anyone can regenerate.
LIMEN_BUYER_MNEMONIC=

# How long a payout may sit unreported before the reconciliation view calls it
# stuck. Nothing is decided from this; it is there so a person can tell "no
# answer yet" from "no answer for an hour".
LIMEN_PAYOUT_STUCK_MS=900000
